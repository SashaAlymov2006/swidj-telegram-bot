# Fill privately; never commit real values.
TELEGRAM_TOKEN=
OWNER_USER_IDS=
GENIUS_TOKEN=
OPENAI_API_KEY=
AUDD_API_TOKEN=
SHAZAM_API_KEY=
# Billable external calls require explicit authorization.
EXTERNAL_PAID_API_ENABLED=false
WHISPER_MODEL=medium
STATE_DB_PATH=/app/data/state.sqlite3
USERS_DB_PATH=/app/data/users.sqlite3
YTDLP_COOKIE_FILE=

# Active audio shares the persistent data volume.
AUDIO_CACHE_DIR=/app/data/audio

# Mini App: localhost preview; set an HTTPS URL only after public deployment.
MINIAPP_ENABLED=false
MINIAPP_HOST=127.0.0.1
MINIAPP_PORT=8765
MINIAPP_URL=

# Free non-commercial AcoustID application key (optional)
ACOUSTID_API_KEY=

# Optional persistent public chart cache, survives container restarts.
MINIAPP_CHART_CACHE_DIR=/app/data/chart-cache
