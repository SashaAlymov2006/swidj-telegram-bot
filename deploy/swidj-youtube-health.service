[Unit]
Description=SwiDJ YouTube availability and authorization monitor
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStartPre=-/usr/bin/python3 /opt/swidj/youtube_session_sync.py run --root /opt/swidj
ExecStart=/usr/bin/python3 /opt/swidj/youtube_health.py run --root /opt/swidj
TimeoutStartSec=150
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
